@page "/preview/{SetlistId}"
@rendermode InteractiveServer
@using System.Net
@inject PlaylistPreviewService PreviewService

<PageTitle>SetPlayList - Preview</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Class="mx-4">Playlist Preview</MudText>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}
else if (Playlist is not null)
{
    <MudText Typo="Typo.subtitle1" GutterBottom="true" Class="mx-4">@Playlist.Name</MudText>

    <MudList T="string" ReadOnly="true">
        @for (int i = 0; i < Playlist.Tracks.Count; i++)
        {
            ProposedTrack track = Playlist.Tracks[i];
            int trackNumber = i + 1;
            <MudListItem>

                <AvatarContent>
                    <MudAvatar Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @trackNumber
                    </MudAvatar>
                </AvatarContent>

                <ChildContent>
                    <MudStack Row AlignItems="AlignItems.Center">

                        <MudText>@track.OriginalSong.Name</MudText>

                        @if (track.OriginalSong.IsTape)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                tape
                            </MudChip>
                        }

                    </MudStack>

                    @if (BuildSongDetails(track) is { } details)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@details</MudText>
                    }

                </ChildContent>
            </MudListItem>

            <MudDivider />
        }
    </MudList>

    <AuthorizeView Context="authContext">
        <NotAuthorized>
            <MudCard Class="my-4">
                <MudText>
                    <MudCardContent>
                        Unfortunately, due to the latest Spotify policy changes, only companies with at least 250k
                        monthly active users can open their app to a wider audience. Development mode allows only 5
                        users to use the app. If you want to create playlists on your Spotify account please contact
                        me at <MudLink Href="https://zlotekmikolaj.com">zlotekmikolaj.com</MudLink>.
                    </MudCardContent>

                    <MudCardActions>
                        <MudButton Href="@_loginUrl" data-enhance-nav="false" Variant="Variant.Text" Color="Color.Primary">
                            Log in with Spotify
                        </MudButton>
                    </MudCardActions>
                </MudText>
            </MudCard>
            <MudStack Row Class="ma-4">
            </MudStack>
        </NotAuthorized>
        <Authorized>
            <MudButton Href="@($"/preview/{SetlistId}/spotify")" Variant="Variant.Outlined" Color="Color.Primary">
                Continue
            </MudButton>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public string SetlistId { get; set; } = string.Empty;

    [PersistentState(AllowUpdates = true)]
    public ProposedPlaylist? Playlist { get; set; }

    private string? _errorMessage;
    private bool _loading = true;
    private string _loginUrl = "/auth/login";

    protected override async Task OnInitializedAsync()
    {
        _loginUrl = $"/auth/login?returnUrl={WebUtility.UrlEncode($"/preview/{SetlistId}/spotify")}";

        if (Playlist is not null)
        {
            _loading = false;
            return;
        }

        var result = await PreviewService.GetSetlistPreviewAsync(SetlistId, CancellationToken.None);
        _loading = false;
        if (result.IsFailure)
        {
            _errorMessage = result.Error!.Message;
            return;
        }

        Playlist = result.Value;
    }

    private static string? BuildSongDetails(ProposedTrack track)
    {
        List<string> parts = [];
        if (track.OriginalSong.With is not null)
        {
            parts.Add($"with: {track.OriginalSong.With}");
        }

        if (track.OriginalSong.OriginalArtist is not null)
        {
            parts.Add($"cover: {track.OriginalSong.OriginalArtist}");
        }

        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }
}
