@page "/preview/{SetlistId}"
@using SetPlayList.Features.SpotifyAuth
@inject PlaylistPreviewService PreviewService

<PageTitle>SetPlayList - Preview</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Playlist Preview</MudText>

<AuthorizeView>
    <NotAuthorized>
        <MudAlert Severity="Severity.Info">
            You have to be logged in to Spotify first.
            <MudButton Href="/auth/login" Variant="Variant.Text" Color="Color.Primary">Log in with Spotify</MudButton>
        </MudAlert>
    </NotAuthorized>
    <Authorized Context="authContext">
        @if (_loading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }
        else if (_playlistSaved)
        {
            <MudAlert Severity="Severity.Success">Playlist "<strong>@_playlist!.Name</strong>" saved on your Spotify profile.</MudAlert>
        }
        else if (_playlist is not null)
        {
            <MudTextField T="string" Label="Playlist Name" @bind-Value="_playlist.Name" Class="mb-4" />

            @foreach (var track in _playlist.Tracks)
            {
                <MudCard Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1">
                            @track.OriginalSong.Name
                            @if (track.OriginalSong.IsTape)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ml-2">tape</MudChip>
                            }
                        </MudText>
                        @if (track.OriginalSong.With is not null)
                        {
                            <MudText Typo="Typo.body2">with: @track.OriginalSong.With</MudText>
                        }
                        @if (track.OriginalSong.OriginalArtist is not null)
                        {
                            <MudText Typo="Typo.body2">cover: @track.OriginalSong.OriginalArtist</MudText>
                        }

                        @if (track.Options.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">No Spotify match found for this song.</MudAlert>
                        }
                        else
                        {
                            <MudRadioGroup T="string" @bind-Value="track.SelectedTrackId" Class="mt-2">
                                @foreach (var option in track.Options)
                                {
                                    <MudRadio Value="@option.Id" Class="d-block">
                                        @option.Name — @string.Join(", ", option.Artists) (@option.AlbumName)
                                    </MudRadio>
                                }
                            </MudRadioGroup>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_submitting">
                Submit
            </MudButton>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter]
    public string SetlistId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ProposedPlaylist? _playlist;
    private string? _accessToken;
    private string? _errorMessage;
    private bool _loading = true;
    private bool _submitting;
    private bool _playlistSaved;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            _loading = false;
            return;
        }

        var authState = await AuthStateTask;
        _accessToken = SpotifyAccessToken.Get(authState.User);
        if (string.IsNullOrEmpty(_accessToken))
        {
            _loading = false;
            return;
        }

        var result = await PreviewService.GeneratePreviewAsync(SetlistId, _accessToken, CancellationToken.None);
        _loading = false;
        if (result.IsFailure)
        {
            _errorMessage = result.Error!.Message;
            return;
        }

        _playlist = result.Value;
    }

    private async Task Submit()
    {
        if (_playlist is null || _accessToken is null)
        {
            return;
        }

        _submitting = true;
        var result = await PreviewService.CreatePlaylistOnSpotifyAsync(_playlist, _accessToken, CancellationToken.None);
        _submitting = false;

        if (result.IsFailure)
        {
            _errorMessage = result.Error!.Message;
            return;
        }

        _playlistSaved = true;
    }
}
