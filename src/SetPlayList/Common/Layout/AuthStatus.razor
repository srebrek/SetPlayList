@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <MudText Class="mx-4">@context.User.Identity?.Name</MudText>
        <MudButton
            OnClick="@(() => Navigation.NavigateTo("auth/logout", forceLoad: true))"
            Variant="Variant.Outlined"
            Color="Color.Primary">
            Log out
        </MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton
            OnClick="@(() => Navigation.NavigateTo(LoginUrl, forceLoad: true))"
            Variant="Variant.Outlined"
            Color="Color.Primary">
            Log in with Spotify
        </MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string LoginUrl =>
        $"/auth/login?returnUrl={WebUtility.UrlEncode("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";
}
