@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <MudText Class="mx-4">@context.User.Identity?.Name</MudText>
        <MudButton
            OnClick="@(() => Navigation.NavigateTo("auth/logout", forceLoad: true))"
            Variant="Variant.Outlined"
            Color="Color.Primary">
            Log out
        </MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton
            OnClick="@(() => Navigation.NavigateTo("login-redirect"))"
            Variant="Variant.Outlined"
            Color="Color.Primary">
            Log in with Spotify
        </MudButton>
    </NotAuthorized>
</AuthorizeView>
