@inherits LayoutComponentBase

<MudThemeProvider Theme="@AppTheme.Default" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudText Typo="Typo.h6" Class="ml-2">SetPlayList</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-4">@context.User.Identity?.Name</MudText>
                <MudButton Href="/auth/logout" Variant="Variant.Text" Color="Color.Inherit">Log out</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/auth/login" Variant="Variant.Filled" Color="Color.Primary">Log in with Spotify</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent Class="pa-4">
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
