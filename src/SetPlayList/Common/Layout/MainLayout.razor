@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider Theme="@AppTheme.Default" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudText Typo="Typo.h6">SetPlayList</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mx-4">@context.User.Identity?.Name</MudText>
                <MudButton
                    OnClick="@(() => Navigation.NavigateTo("auth/logout", forceLoad: true))"
                    Variant="Variant.Outlined"
                    Color="Color.Primary">
                    Log out
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton
                    OnClick="@(() => Navigation.NavigateTo("auth/login", forceLoad: true))"
                    Variant="Variant.Outlined"
                    Color="Color.Primary">
                    Log in with Spotify
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
