@inherits LayoutComponentBase
@using System.Net
@inject NavigationManager Navigation

<MudThemeProvider Theme="@AppTheme.Default" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudText Typo="Typo.h6">SetPlayList</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mx-4">@context.User.Identity?.Name</MudText>
                <form action="/auth/logout" method="post">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">
                        Log out
                    </MudButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="@LoginUrl" data-enhance-nav="false" Variant="Variant.Outlined" Color="Color.Primary">
                    Log in with Spotify
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private string LoginUrl =>
        $"/auth/login?returnUrl={WebUtility.UrlEncode("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";
}
